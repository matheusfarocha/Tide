{
  "name": "tide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "phone": "vite --host --mode phone",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "convex": "convex dev",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "convex": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^5.4.9",
    "vitest": "^2.1.9"
  }
}
